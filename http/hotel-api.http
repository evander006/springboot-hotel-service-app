### 5. Get all hotels summary
GET http://localhost:8092/property-view/hotels

### 6. Get hotel details by id = 1
GET http://localhost:8092/property-view/hotels/1

### 7. Get hotel details by id = 2
GET http://localhost:8092/property-view/hotels/2

### 8. Add amenities to hotel 1
POST http://localhost:8092/property-view/hotels/1/amenities
Content-Type: application/json

[
  "Free parking",
  "Free WiFi",
  "Non-smoking rooms",
  "Concierge",
  "On-site restaurant",
  "Fitness center",
  "Pet-friendly rooms",
  "Room service",
  "Business center",
  "Meeting rooms"
]

